{
  "name": "adliyyah-fees-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "create:internal-user": "npm run build && node dist/backend/src/scripts/create-internal-user.js",
    "create:portal-admin": "npm run build && node dist/backend/src/scripts/create-content-portal-user.js",
    "seed:subcategory-content": "npm run build && node dist/backend/src/scripts/seed-subcategory-content.js",
    "diagnose:connection": "node scripts/diagnose-supabase-connection.js",
    "diagnose:schema": "node scripts/diagnose-schema.js",
    "diagnose:endpoints": "node scripts/diagnose-endpoints.js",
    "diagnose:users": "node scripts/diagnose-users.js",
    "diagnose:login": "node scripts/diagnose-login.js",
    "diagnose:all": "node scripts/diagnose-all.js",
    "test:all": "npm run build && node scripts/test-all.js",
    "test:deed-sealing": "npm run build && node scripts/test-deed-sealing.js",
    "test:env": "npm run build && node scripts/test-env-validation.js",
    "test:pii": "npm run build && node scripts/test-pii-redaction.js",
    "test:health": "npm run build && node scripts/test-lifecycle-health.js",
    "migrate": "node scripts/migrate.js",
    "test:cache": "node scripts/test-cache.js",
    "test:security": "node scripts/test-phase1-security.js",
    "test:auth": "node scripts/test-trpc-auth.js",
    "test:session": "node scripts/test-session-cookies.js",
    "migrate:supabase": "node scripts/migrate-supabase.js",
    "fix:rls": "node scripts/fix-rls-permissions.js",
    "create-test-user": "node scripts/create-test-user.js",
    "reset-password": "node scripts/reset-user-password.js",
    "manage-users": "node scripts/manage-users.js",
    "check:tables": "node scripts/check-table-permissions.js",
    "fix:all-rls": "node scripts/auto-fix-rls.js",
    "scan:all-tables": "node scan-all-tables.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^8.3.1",
    "@google-cloud/vision": "^5.3.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.46.1",
    "@trpc/server": "^11.0.0-rc.446",
    "@types/sanitize-html": "^2.16.0",
    "arabic-persian-reshaper": "^1.0.1",
    "bidi-js": "^1.0.3",
    "docxtemplater": "^3.68.3",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "html-pdf-node": "^1.0.8",
    "ioredis": "^6.0.0",
    "nodemailer": "^6.10.1",
    "ollama": "^0.6.3",
    "openai": "^6.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.31.0",
    "qrcode": "^1.5.4",
    "resend": "^4.7.0",
    "sanitize-html": "^2.17.0",
    "tesseract.js": "^6.0.1",
    "tmp-promise": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.16.0",
    "pg": "^8.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
